  m_TableData:
  - m_Id: 8128098304
    m_Localized: "Noathyn: \u03A9\u03C7, \u03B7 \u03CE\u03C1\u03B1 \u03C0\u03AD\u03C1\u03B1\u03C3\u03B5.
      \u039A\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1 \u03BD\u03B1 \u03B3\u03C5\u03C1\u03AF\u03C3\u03C9
      \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C0\u03C1\u03B9\u03BD \u03C0\u03AD\u03C3\u03B5\u03B9
      \u03B7 \u03BD\u03CD\u03C7\u03C4\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 1115470491648
    m_Localized: "Noathyn: \u03A4\u03B9; \u0397 \u03B3\u03AD\u03C6\u03C5\u03C1\u03B1
      \u03BA\u03B1\u03C4\u03AD\u03C1\u03B5\u03C5\u03C3\u03B5; \u03A0\u03AC\u03BB\u03B9;
      \u03A7\u03BC... \u038A\u03C3\u03C9\u03C2 \u03BD\u03B1 \u03BC\u03C0\u03BF\u03C1\u03AD\u03C3\u03C9
      \u03BD\u03B1 \u03C0\u03B5\u03C1\u03AC\u03C3\u03C9 \u03B1\u03C0\u03CC \u03C4\u03B1
      \u03B5\u03C1\u03B5\u03AF\u03C0\u03B9\u03B1 \u03C4\u03BF\u03C5 Xetniay \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03C4\u03BF\u03BD \u03B4\u03C1\u03CC\u03BC\u03BF \u03C0\u03BB\u03AC\u03B9
      \u03B1\u03C0' \u03C4\u03BF \u03C0\u03BF\u03C4\u03AC\u03BC\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 1118653968384
    m_Localized: "Noathyn: \u03A4\u03B9 \u03AE\u03C4\u03B1\u03BD \u03B1\u03C5\u03C4\u03CC;
      \u0388\u03BD\u03B1\u03C2 \u03A4\u03C1\u03CC\u03BC\u03BF\u03C2; \u03A4\u03CC\u03C3\u03BF
      \u03AD\u03BE\u03C9 \u03B1\u03C0\u03CC \u03C4\u03B1 \u03C3\u03CD\u03BD\u03BF\u03C1\u03B1
      \u03C4\u03B7\u03C2 Aleunr; \u039A\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1
      \u03BD\u03B1 \u03C4\u03BF \u03C0\u03BB\u03B7\u03C3\u03B9\u03AC\u03C3\u03C9
      \u03C0\u03C1\u03BF\u03C3\u03B5\u03BA\u03C4\u03B9\u03BA\u03AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1121527066624
    m_Localized: "Noathyn: [\u0395\u03BA\u03C0\u03BD\u03AD\u03B5\u03B9] \u0395\u03BB\u03C0\u03AF\u03B6\u03C9
      \u03B1\u03C5\u03C4\u03CC\u03C2 \u03BD\u03B1 \u03AE\u03C4\u03B1\u03BD \u03BF
      \u03BC\u03CC\u03BD\u03BF\u03C2. \u0391\u03BB\u03BB\u03AC... \u03A4\u03B9 \u03BA\u03AC\u03BD\u03B5\u03B9
      \u03AD\u03BD\u03B1\u03C2 \u03A4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C4\u03CC\u03C3\u03BF
      \u03AD\u03BE\u03C9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD Aleunr; \u039F \u039D\u03B1\u03CC\u03C2
      \u03A4\u03BF\u03C5 Xetniay \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C4\u03BF
      \u03BA\u03AD\u03BD\u03C4\u03C1\u03BF \u03C4\u03BF\u03C5 \u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03AF\u03BF\u03C5.
      \u039D\u03B1 \u03AD\u03C8\u03B1\u03C7\u03BD\u03B5 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03C4\u03B9
      \u03C3\u03C4\u03B1 \u03B5\u03C1\u03B5\u03AF\u03C0\u03B9\u03B1; \u039A\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1
      \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03AD\u03C7\u03C9!"
    m_Metadata:
      m_Items: []
  - m_Id: 9511062007808
    m_Localized: "Noathyn: \u03A4- \u03A4\u03B9 \u03AE\u03C4\u03B1\u03BD \u03B1\u03C5\u03C4\u03CC;"
    m_Metadata:
      m_Items: []
  - m_Id: 9513717002240
    m_Localized: "Noathyn: \u0388\u03C3\u03C0\u03B1\u03C3\u03B5 \u03BA\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03AE \u03B7 \u03B3\u03AD\u03C6\u03C5\u03C1\u03B1; \u0388\u03BB\u03B1
      \u03C4\u03CE\u03C1\u03B1! \u03A0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B5...
      \u0391\u03C5\u03C4\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03BF\u03BB\u03CC\u03BD\u03B1
      \u03BC\u03B1\u03BD\u03AC\u03C0\u03B5\u03C4\u03C1\u03B1\u03C2; \u03A0\u03B5\u03C2
      \u03BC\u03BF\u03C5 \u03CC\u03C4\u03B9 \u03AD\u03C7\u03C9 \u03C4\u03B7\u03BD
      \u039C\u03B1\u03BD\u03AC\u03C0\u03B5\u03C4\u03C1\u03AC \u03BC\u03BF\u03C5 \u03BC\u03B1\u03B6\u03AF
      \u03BC\u03BF\u03C5... \u039D\u03B1\u03B9! \u0395\u03C0\u03B9\u03C4\u03AD\u03BB\u03BF\u03C5\u03C2
      \u03BB\u03AF\u03B3\u03B7 \u03C4\u03CD\u03C7\u03B7."
    m_Metadata:
      m_Items: []
  - m_Id: 9515667353600
    m_Localized: "Noathyn: \u0391\u03C5\u03C4\u03AE... \u0397 \u03C6\u03C9\u03BD\u03AE
      \u03C3\u03C4\u03B1 \u03B5\u03C1\u03B5\u03AF\u03C0\u03B9\u03B1... \u03A0\u03BF\u03B9\u03BF\u03C2
      \u03AE\u03C4\u03B1\u03BD; \u03A4\u03B9 \u03AD\u03BB\u03B5\u03B3\u03B5; \u0398\u03B1
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BF Xetniay \u03BD\u03B1
      \u03BE\u03C5\u03C0\u03BD\u03AC\u03B5\u03B9; \u039B\u03B5\u03C2 \u03B3\u03B9\u03B1
      \u03B1\u03C5\u03C4\u03CC \u03BD\u03B1 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03A4\u03C1\u03CC\u03BC\u03BF\u03B9 \u03C4\u03CC\u03C3\u03BF \u03AD\u03BE\u03C9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B2\u03B1\u03C3\u03AF\u03BB\u03B5\u03B9\u03BF;"
    m_Metadata:
      m_Items: []
