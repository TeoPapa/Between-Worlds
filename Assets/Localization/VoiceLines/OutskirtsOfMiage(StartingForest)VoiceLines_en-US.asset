  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: OutskirtsOfMiage(StartingForest)VoiceLines_en-US
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: 2a56a2c82fe61dc469addf332f227fab, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8128098304
    m_Localized: 'Noathyn: Oh, time passed. I should probably go home before night
      falls.'
    m_Metadata:
      m_Items: []
  - m_Id: 1115470491648
    m_Localized: 'Noathyn: What? The bridge broke? Again? Hmm... Maybe I can pass
      from the ruins of Xetniay following the path near the river.'
    m_Metadata:
      m_Items: []
  - m_Id: 1118653968384
    m_Localized: 'Noathyn: What was that? A Horror? This far out in the outskirts
      of Aleunr? Better engage it cautiously.'
    m_Metadata:
      m_Items: []
  - m_Id: 1121527066624
    m_Localized: 'Noathyn: [Exhales] I hope this was the only one. But... What was
      a Horror doing this far outside of Aleunr? The Temple Of Xetniay is in the
      middle of the kingdom. Was it searching for something in the ruins? Better
      be careful!'
    m_Metadata:
      m_Items: []
  - m_Id: 9508331515904
    m_Localized: 'Unknown Voice: Yllanif modeerf!'
    m_Metadata:
      m_Items: []
  - m_Id: 9511062007808
    m_Localized: 'Noathyn: W- What was that?'
    m_Metadata:
      m_Items: []
  - m_Id: 9513717002240
    m_Localized: "Noathyn: This bridge broke also? Come on! Wait\u2026 Is that a
      Manastone Pillar? Tell me that I have my Manastone with me\u2026 Yes! Finally
      some luck!"
    m_Metadata:
      m_Items: []
  - m_Id: 9515667353600
    m_Localized: "Noathyn: That\u2026 Voice in the ruins\u2026 Who was that? What
      did it mean? Could it be that Xetniay starts to wake up? Is that why the Horrors
      have come so far out of the kingdom?"
    m_Metadata:
      m_Items: []
  - m_Id: 9517751922688
    m_Localized: '[Horror Shrieks]'
    m_Metadata:
      m_Items: []
  - m_Id: 9520230756352
    m_Localized: "Noathyn: Oh no! Horrors nearby! They might have gone to my home\u2026
      Mom! Dad!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
