    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 65124495360
    m_Localized: What do you want, elf?
    m_Metadata:
      m_Items: []
  - m_Id: 213573496832
    m_Localized: I would like some tomatoes.
    m_Metadata:
      m_Items: []
  - m_Id: 260428066816
    m_Localized: I would like some juice.
    m_Metadata:
      m_Items: []
  - m_Id: 289297461248
